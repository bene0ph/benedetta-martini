---
/**
 * Plate — one photograph, set in its measure, with its credit line.
 *
 * The number is the plate number in the sequence; it is shown, because a
 * numbered plate is a claim that the sequence was chosen rather than dumped.
 */
import { Image } from 'astro:assets';
import type { Plate } from '../data/work';
import { SERIES } from '../data/work';

interface Props {
  plate: Plate;
  n: number;
  /** widths the browser may pick from, by measure */
  eager?: boolean;
}

const { plate, n, eager = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/plates/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const entry = images[`../assets/plates/${plate.file}`];
if (!entry) {
  throw new Error(
    `Plate "${plate.file}" is listed in src/data/work.ts but is not in src/assets/plates/`,
  );
}

// The widest this photograph can ever actually be drawn, from the columns it
// spans against the trim width — so we never ship a 2500px file to fill a
// three-column slot.
const TRIM = 1312;
const cap = Math.round((plate.span / 12) * TRIM);

// The image's own ratio, handed to CSS so the height cap can be expressed in
// the photograph's terms rather than in a magic number per measure.
const ar = entry.default.width / entry.default.height;

const series = SERIES.find((s) => s.slug === plate.series);
const no = String(n).padStart(2, '0');
---

<figure
  class="plate"
  data-plate
  data-span={plate.span}
  data-justify={plate.justify ?? 'start'}
  data-section={series ? `${series.title} — ${series.place}` : ''}
  style={`--col:${plate.col}; --span:${plate.span}; --air:${plate.air ?? 2}; --ar:${ar.toFixed(4)}`}
  id={`plate-${no}`}
>
  <div class="plate__frame rise">
    <Image
      class="plate__img"
      src={entry.default}
      alt={`${plate.title} — ${plate.place}`}
      widths={[Math.round(cap / 2), cap, Math.min(cap * 2, entry.default.width)]}
      sizes={`(max-width: 736px) 92vw, ${cap}px`}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      quality={82}
    />
  </div>

  <figcaption class="plate__caption marg rise rise--late">
    <span class="plate__no">{no}</span>
    <span>
      <span class="plate__what">{plate.title}</span>
      <span class="plate__where">{plate.place}</span>
    </span>
    <span class="plate__when">{plate.date}</span>
  </figcaption>
</figure>
