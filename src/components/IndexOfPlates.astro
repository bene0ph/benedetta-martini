---
/**
 * Index of Plates — the back matter.
 *
 * Borrowed wholesale from the "List of Illustrations" at the back of a
 * photography book, leader dots included. It is the piece that makes a modest
 * edit read as a bound, finished object instead of as everything that existed.
 */
import type { Plate } from '../data/work';

interface Props { plates: Plate[]; title?: string }
const { plates, title = 'Index of Plates' } = Astro.props;
---

<section class="back">
  <div class="back__inner">
    <h2 class="back__title">{title}</h2>
    <ol class="index">
      {
        plates.map((p, i) => {
          const no = String(i + 1).padStart(2, '0');
          return (
            <li>
              <a href={`#plate-${no}`} class="marg">
                <span class="index__no">{no}</span>
                <span class="index__what">{p.title}, {p.place}</span>
                <span class="index__lead" aria-hidden="true"></span>
                <span class="index__when">{p.date}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
