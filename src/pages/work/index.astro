---
/**
 * Series — the contents page.
 *
 * A table of contents, not a gallery of thumbnails. The type does the
 * seducing; the photographs are one click away and are better for the wait.
 */
import Paper from '../../layouts/Paper.astro';
import Colophon from '../../components/Colophon.astro';
import { SERIES, ALL_PLATES } from '../../data/work';

const count = (slug: string) => ALL_PLATES.filter((p) => p.series === slug).length;
---

<Paper title="Series — Benedetta Martini" section="Contents">
  <section class="opener">
    <h1 class="opener__title">Series</h1>
    <div class="opener__meta marg marg--faint">
      <span>{SERIES.length} bodies of work</span>
      <span>{ALL_PLATES.length} plates</span>
      <span>2022 &mdash; 2024</span>
    </div>
  </section>

  <div class="contents">
    {
      SERIES.map((s, i) => (
        <a class="contents__row rise" href={`/work/${s.slug}`}>
          <span class="marg marg--faint">{String(i + 1).padStart(2, '0')}</span>
          <span>
            <span class="contents__title">{s.title}</span>
            <span class="contents__sub marg marg--faint">
              {s.place} &nbsp;·&nbsp; {s.date} &nbsp;·&nbsp; {s.kind}
            </span>
          </span>
          <span class="contents__count marg marg--faint">
            {String(count(s.slug)).padStart(2, '0')} plates
          </span>
        </a>
      ))
    }
  </div>

  <Colophon />
</Paper>
