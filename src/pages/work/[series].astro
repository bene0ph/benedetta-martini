---
/**
 * A single series.
 *
 * Opens like a chapter: title, standfirst, credits, then the plates. Same
 * paper, same apparatus, tighter pacing — a chapter reads faster than a folio.
 */
import Paper from '../../layouts/Paper.astro';
import Plate from '../../components/Plate.astro';
import Colophon from '../../components/Colophon.astro';
import { SERIES, ALL_PLATES } from '../../data/work';

export function getStaticPaths() {
  return SERIES.map((series) => ({
    params: { series: series.slug },
    props: { series },
  }));
}

const { series } = Astro.props;
const plates = ALL_PLATES.filter((p) => p.series === series.slug);
const order = SERIES.findIndex((s) => s.slug === series.slug);
const next = SERIES[(order + 1) % SERIES.length];
---

<Paper
  title={`${series.title} — Benedetta Martini`}
  description={series.text}
  section={`${series.title} — ${series.place}`}
  total={plates.length}
>
  <section class="opener">
    <span class="marg marg--faint">Series {String(order + 1).padStart(2, '0')}</span>
    <h1 class="opener__title">{series.title}</h1>

    <div class="prose" style="margin-top:1rem">
      <p>{series.text}</p>
    </div>

    <dl class="credits" style="margin-top:2rem">
      <div><dt class="marg marg--faint">Place</dt><dd>{series.place}</dd></div>
      <div><dt class="marg marg--faint">Made</dt><dd>{series.date}</dd></div>
      <div><dt class="marg marg--faint">Nature</dt><dd>{series.kind}</dd></div>
      <div><dt class="marg marg--faint">Plates</dt><dd>{plates.length}</dd></div>
    </dl>
  </section>

  <div class="sequence" style="margin-top: var(--baseline)">
    {plates.map((plate, i) => <Plate plate={plate} n={i + 1} eager={i === 0} />)}
  </div>

  <section class="back">
    <div class="back__inner">
      <span class="marg marg--faint">Next series</span>
      <a class="contents__row rise" href={`/work/${next.slug}`} style="border-bottom:var(--rule)">
        <span class="marg marg--faint">
          {String((SERIES.findIndex((s) => s.slug === next.slug)) + 1).padStart(2, '0')}
        </span>
        <span>
          <span class="contents__title">{next.title}</span>
          <span class="contents__sub marg marg--faint">{next.place} &nbsp;·&nbsp; {next.date}</span>
        </span>
        <span class="contents__count marg marg--faint">Continue &rarr;</span>
      </a>
    </div>
  </section>

  <Colophon />
</Paper>
