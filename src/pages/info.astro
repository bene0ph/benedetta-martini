---
/**
 * Info — the back of the book.
 *
 * Set as a spread: the claim on the left, the explanation on the right. This
 * is the page that turns an art director into an email, so it is the one page
 * on the site where the words matter more than the photographs.
 *
 * NOTE (Benedetta): the bio below is placeholder, written from what your old
 * site showed. Replace it in your own words.
 */
import Paper from '../layouts/Paper.astro';
import Colophon from '../components/Colophon.astro';
import { STUDIO } from '../data/work';

const clients = [
  "Joseph's",
  'Ripponlea Estate',
  'Albert’s Wine Bar',
  'Sojourn',
  '306 Collins',
  'Bagni Paradiso',
];

const services = [
  { what: 'Menu & dish', detail: 'A full menu photographed in a day, in your room, on your light.' },
  { what: 'Venue & atmosphere', detail: 'The space as it looks at the hour people actually arrive.' },
  { what: 'Produce & process', detail: 'Growers, markets, kitchens — the part of the story before the plate.' },
  { what: 'Travel & editorial', detail: 'Commissioned features, on location, in Italy and Australia.' },
];
---

<Paper title="Info — Benedetta Martini" section="Info">
  <section class="opener">
    <h1 class="opener__title">Info</h1>
    <div class="opener__meta marg marg--faint">
      <span>{STUDIO.discipline}</span>
      <span>{STUDIO.city}</span>
      <span>Commissions open</span>
    </div>
  </section>

  <div class="sheet" style="padding-top: var(--baseline)">
    <div class="spread">
      <div class="spread__lede">
        <p class="lede">
          Food is never only food. It is a season, a coastline, and somebody&rsquo;s
          grandmother&rsquo;s habit.
        </p>
      </div>

      <div class="spread__body prose">
        <p>
          I am an Italian food and travel photographer based in {STUDIO.city}. I
          grew up eating in Liguria and learned to cook in Tuscany, which is a
          long way of saying that I have never been able to photograph a dish
          without also wanting to photograph the road it came in on.
        </p>
        <p>
          My work is made on location and in available light. I shoot
          restaurants, producers, hotels and editorial features — usually over a
          single day, usually with the kitchen still running, because a dining
          room at service looks like nothing a studio can build.
        </p>
        <p>
          I work in English and Italian, travel constantly, and am happy anywhere
          there is a window. If you are planning something,
          <a href={`mailto:${STUDIO.email}`}>write to me</a> — tell me the room,
          the season, and what you want people to feel.
        </p>
      </div>
    </div>

    <div class="spread" style="margin-top: calc(var(--baseline) * 1.3)">
      <div class="spread__wide">
        <h2 class="marg marg--faint" style="margin: 0 0 1rem">Commissions</h2>
        <dl class="credits">
          {
            services.map((s) => (
              <div>
                <dt class="marg marg--ink">{s.what}</dt>
                <dd>{s.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="spread__side">
        <h2 class="marg marg--faint" style="margin: 0 0 1rem">Selected clients</h2>
        <p class="roll">
          {
            clients.map((c, i) => (
              <>
                {i > 0 && <i aria-hidden="true">·</i>}
                <span>{c}</span>
              </>
            ))
          }
        </p>
      </div>
    </div>
  </div>

  <Colophon />
</Paper>
